{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.kya-os.org/v1/protocol/audit/entry/v1.0.0",
  "title": "KYA-OS Audit Entry Core v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "ledgerId", "ledgerEpochId", "sequence", "previousEntryDigest", "recordedAt", "recorder", "eventDigest", "event", "evidenceManifestDigest", "integritySuite"],
  "properties": {
    "schema": { "const": "https://schema.kya-os.org/v1/protocol/audit/entry/v1.0.0" },
    "ledgerId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "ledgerEpochId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "sequence": { "$ref": "#/$defs/decimal" },
    "previousEntryDigest": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
    "recordedAt": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "recorder": { "$ref": "#/$defs/signerRef" },
    "eventDigest": { "$ref": "#/$defs/digest" },
    "event": { "$ref": "./audit-event.schema.json" },
    "evidenceManifestDigest": { "$ref": "#/$defs/digest" },
    "integritySuite": { "const": "KYA-AUDIT-JCS-SHA256-JWS-2026" }
  },
  "$defs": {
    "decimal": { "type": "string", "maxLength": 20, "pattern": "^(0|[1-9][0-9]*)$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "signerRef": {
      "type": "object", "additionalProperties": false, "required": ["did", "kid", "alg"],
      "properties": {
        "did": { "type": "string", "minLength": 5, "maxLength": 2048, "pattern": "^did:[^\\r\\n]+$" },
        "kid": { "type": "string", "minLength": 1, "maxLength": 2304 },
        "alg": { "enum": ["EdDSA", "ES256"] }
      }
    }
  }
}
