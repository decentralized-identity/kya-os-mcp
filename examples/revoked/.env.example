# Copy to .env.local and fill in. Everything with a value here is a PUBLIC
# default; every empty var is generated for you by the setup scripts and is
# SECRET (gitignored .env.local, 0600 — never commit it).
#
# Tier-0 (`npm run verify:once`) needs NOTHING from this file: it defaults to
# the DEF CON 34 demo's public issuer DID + on-chain status list.

# --- cheqd registrar / resolver (staging registrar sponsors testnet DID fees) ---
CHEQD_REGISTRAR_URL=https://did-registrar-staging.cheqd.net/1.0
CHEQD_RESOLVER_URL=https://resolver.cheqd.net

# --- Issuer identity (Responsible Party). Created by `npm run create:did` ---
CHEQD_DID=
CHEQD_KID=
CHEQD_PRIVATE_KEY_BASE64=
CHEQD_PUBLIC_KEY_BASE64=

# --- Agent signing identity (did:key). Created by `npm run issue:delegation` ---
AGENT_DID=
AGENT_ED25519_PRIVATE_KEY_BASE64=
AGENT_ED25519_PUBLIC_KEY_BASE64=

# --- Cosmos testnet access for the agent's bank sends (verified by `npm run check:b`) ---
CHEQD_RPC_URL=https://rpc.cheqd.network
CHEQD_CHAIN_ID=cheqd-testnet-6
CHEQD_DENOM=ncheq
CHEQD_GAS_PRICE=5000ncheq

# --- Wallets. Created by `npm run gen:accounts`; fund via cheqd testnet faucet ---
AGENT_MNEMONIC=
ISSUER_FEE_MNEMONIC=

# --- Demo configuration ---
STATUSLIST_NAME=kya-statuslist-demo
STATUSLIST_INDEX=94
EXPLORER_TX_URL=https://testnet-explorer.cheqd.io/transactions/{hash}
