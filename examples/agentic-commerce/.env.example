# Copy to .env.local. `npm run setup` fills in the RP, merchant and agent
# identity keys. Optional testnet wallet secrets are supplied separately.
# .env.local is gitignored and written 0600.

# --- Ports ------------------------------------------------------------------
MERCHANT_PORT=4949          # merchant edge: MCP at /mcp, console at /, discovery at /.well-known/mcp
RP_PORT=4950                # the Responsible Party's hub: did.json, status list, revocation ceremony
# Both services default to loopback. Set 0.0.0.0 inside a hosted container.
# Keep the deployment's gateway and presenter-control authentication in place.
BIND_HOST=127.0.0.1

# Public advertised origins for an HTTPS reverse-proxy deployment.
# Omit for localhost. These do not replace gateway authentication/network setup.
# MERCHANT_ORIGIN=https://merchant.example
# RP_ORIGIN=https://authorization.example
# RP_ORIGIN pins consent URLs, browser Origin checks and Google sign-in.
# TLS may terminate at the proxy; internal HTTP does not change this binding.

# Persistent state root for a hosted deployment. One merchant replica per volume.
# Includes merchant payment recovery and agent wallet/attempt state.
# Set these as process/deployment environment variables before startup.
# DEMO_VAR_DIR=/data/var
# DEMO_DATA_DIR=/data/authenticators

# --- The Responsible Party (issuer of the delegation, host of the revocation list)
# Default is a did:web that resolves to the hub on this laptop (rehearsal mode).
# For the stage, set a public did:web you control and publish var/rp/did.json at
# its /.well-known/did.json; the hub keeps serving the same document as the
# offline mirror. did:web resolution is HTTPS by spec; the merchant rewrites
# https://localhost:<RP_PORT>/ to http:// ONLY for localhost (ALLOW_INSECURE_LOCALHOST).
RP_DID=did:web:localhost%3A4950
RP_KID=
RP_PRIVATE_KEY_BASE64=
RP_PUBLIC_KEY_BASE64=
# Where the merchant reads the RP's DID document when the network is down or
# OFFLINE=1 is set. Defaults to the hub's own copy.
RP_DID_MIRROR_URL=http://localhost:4950/.well-known/did.json
ALLOW_INSECURE_LOCALHOST=1
OFFLINE=0

# --- The revocation list the RP hosts (any URL; the merchant verifies its signature)
STATUS_LIST_URL=http://localhost:4950/status-list

# --- The merchant edge (verifier + signer of receipts) ---------------------
MERCHANT_DID=
MERCHANT_PRIVATE_KEY_BASE64=
MERCHANT_PUBLIC_KEY_BASE64=
MERCHANT_NAME=Dal Giardino Direct (demo merchant)

# --- The shopping agent (holds its own did:key; the LLM never sees it) -----
AGENT_DID=
AGENT_ED25519_PRIVATE_KEY_BASE64=
AGENT_ED25519_PUBLIC_KEY_BASE64=

# --- Optional payment/checkout demonstration --------------------------------
# Keep disabled for the original consent/order/revocation workshop flow.
# Enabling adds payment tool arguments, discovery and HTTP checkout endpoints.
COMMERCE_PAYMENTS=0
# With payments enabled, place_order still defaults to order-only.
# sandbox verifies real x402 payment signatures locally but never moves funds.
# testnet supports Base Sepolia USDC only. Mainnet is not supported.
PAYMENT_MODE=sandbox

# Fixed WORKSHOP conversion, not a market rate: 10000 atomic USDC units per
# CHF cent gives CHF 39.80 -> 39.800000 test USDC (USDC has 6 decimal places).
# Merchant and agent must use the same rate. Each immutable quote discloses it.
X402_ATOMIC_UNITS_PER_CHF_CENT=10000

# Required only for PAYMENT_MODE=testnet. Keep unset for the default sandbox
# recipient. Set a testnet recipient address and a dedicated test-funded key.
# Never commit a wallet key or paste it into Claude.
# X402_PAY_TO=0xYOUR_BASE_SEPOLIA_RECIPIENT_ADDRESS
# AGENT_EVM_PRIVATE_KEY=0xYOUR_64_HEX_CHARACTER_TEST_WALLET_KEY

# Optional comma-separated HTTPS platform profile URLs, explicitly allowlisted.
# The merchant's own /agent/.well-known/ucp profile is always included.
# UCP_PLATFORM_PROFILES=https://platform.example/.well-known/ucp

# --- The delegation ----------------------------------------------------------
# Scope: a GS1 Digital Link product class (prefix match covers /10/<lot> and
# /21/<serial> beneath it). Cap and window live INSIDE the signed credential.
SCOPE_PRODUCT_CLASS=https://id.gs1.org/01/09506000134352
SPEND_CAP=50.00
SPEND_CURRENCY=CHF
VALID_HOURS=48

# --- Optional human issuance ceremony (independent of revocation) ------------
# Default: one click issues the grant. No authenticator or account is required.
# With a registered key and CONSENT_WEBAUTHN=1, approval requires an assertion.
CONSENT_WEBAUTHN=0

# Optional named human: Google Identity Services web client ID (public value).
# Authorized JavaScript origins: http://localhost and http://localhost:4950.
# When hosted, add the exact HTTPS RP_ORIGIN to the Google client's origins.
# No client secret or redirect URI is used. Configuring this requires sign-in
# and an account-bound passkey for every new grant; no click-wrap fallback.
GOOGLE_CLIENT_ID=

# --- Hardware-key revocation ceremony (WebAuthn) ------------------------------
# KEY_SETUP=1 enables authenticator registration at /setup-key.html (one-time).
# KEY_WEBAUTHN=1 makes revocation REQUIRE a registered authenticator's touch.
# DEMO_BYPASS_WEBAUTHN=1 restores the software path on stage if a key misbehaves.
KEY_SETUP=0
KEY_WEBAUTHN=0
DEMO_BYPASS_WEBAUTHN=0
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:4949
# Hosted: WEBAUTHN_RP_ID is the passkey RP domain (without scheme/port).
# WEBAUTHN_ORIGIN is where the registration/revocation page runs; consent
# assertions always use RP_ORIGIN. Preserve the deployed ceremony location.
