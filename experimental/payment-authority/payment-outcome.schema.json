{
  "$schema": "https://schema.kya-os.org/experimental/payment-authority/2026-09-22/meta",
  "$id": "https://schema.kya-os.org/experimental/payment-authority/2026-09-22/outcome",
  "title": "KYA-OS Payment Outcome (Experimental)",
  "description": "Experimental discussion draft: the Payment Outcome of the KYA-OS Payment Authority Profile (profile section 8.3). Not stable or ratified.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profile",
    "outcomeId",
    "attemptId",
    "sequence",
    "producer",
    "intentDigest",
    "authorizationDigest",
    "state",
    "updatedAt",
    "idempotency",
    "rail",
    "evidence"
  ],
  "properties": {
    "schema": {
      "const": "https://schema.kya-os.org/experimental/payment-authority/2026-09-22/outcome"
    },
    "profile": {
      "const": "org.kya-os/payments.v1"
    },
    "outcomeId": {
      "$ref": "#/$defs/reference"
    },
    "attemptId": {
      "$ref": "#/$defs/reference",
      "description": "The identifier of the attempt (profile section 8.3)."
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "The observation's position in the attempt's stream (profile section 8.3)."
    },
    "previousOutcomeDigest": {
      "$ref": "#/$defs/digest",
      "description": "The outcome digest of the observation before this one (profile sections 8.3 and 10)."
    },
    "producer": {
      "$ref": "#/$defs/reference"
    },
    "intentDigest": {
      "$ref": "#/$defs/digest"
    },
    "authorizationDigest": {
      "$ref": "#/$defs/digest"
    },
    "state": {
      "enum": [
        "authorized",
        "submitted",
        "settlement_pending",
        "settled",
        "failed"
      ]
    },
    "updatedAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "idempotency": {
      "$ref": "#/$defs/idempotency"
    },
    "rail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[Hh][Tt][Tt][Pp][Ss]?:"
              }
            },
            "required": [
              "id"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "specDigest": true
            },
            "required": [
              "specDigest"
            ]
          }
        }
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/reference"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "specDigest": {
          "$ref": "#/$defs/digest"
        },
        "transactionRef": {
          "$ref": "#/$defs/reference"
        },
        "reconciliationRef": {
          "$ref": "#/$defs/reference"
        }
      }
    },
    "effectAmount": {
      "$ref": "#/$defs/amount",
      "description": "The amount the rail reported as moved (profile section 8.3)."
    },
    "reason": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "newIntentMaySucceed"
      ],
      "properties": {
        "code": {
          "enum": [
            "payment_failed",
            "payment_quote_expired",
            "payment_authority_expired",
            "payment_delegation_revoked",
            "payment_authority_recheck_failed",
            "payment_denied"
          ],
          "description": "The outcome reason (profile sections 8.3 and 13)."
        },
        "newIntentMaySucceed": {
          "type": "boolean",
          "description": "Whether a new intent for the purchase may succeed (profile section 8.3)."
        },
        "basis": {
          "enum": [
            "close",
            "slot",
            "tracked"
          ],
          "description": "The rail evidence that ends a rail failure (profile section 8.3)."
        },
        "detailDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    },
    "correction": {
      "const": true,
      "description": "A correction (profile section 8.3)."
    },
    "finality": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]{0,63}$",
      "description": "The finality level of a settlement (profile section 8.3)."
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "sequence": {
            "const": 0
          }
        },
        "required": [
          "sequence"
        ]
      },
      "then": {
        "type": "object",
        "not": {
          "type": "object",
          "properties": {
            "previousOutcomeDigest": true
          },
          "required": [
            "previousOutcomeDigest"
          ]
        }
      },
      "else": {
        "type": "object",
        "properties": {
          "previousOutcomeDigest": true
        },
        "required": [
          "previousOutcomeDigest"
        ]
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "state": {
            "const": "settled"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "rail": {
            "type": "object",
            "properties": {
              "id": true,
              "version": true,
              "transactionRef": true
            },
            "required": [
              "id",
              "version",
              "transactionRef"
            ]
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "state": {
            "const": "settlement_pending"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "rail": {
            "type": "object",
            "properties": {
              "id": true,
              "version": true,
              "reconciliationRef": true
            },
            "required": [
              "id",
              "version",
              "reconciliationRef"
            ]
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "state": {
            "const": "failed"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "reason": true
        },
        "required": [
          "reason"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "settled"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "effectAmount": true
        },
        "required": [
          "effectAmount"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "not": {
              "const": "settled"
            }
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "effectAmount": false
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "correction": {
            "const": true
          }
        },
        "required": [
          "correction"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "state": {
            "enum": [
              "settled",
              "settlement_pending"
            ]
          },
          "sequence": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "state",
          "sequence"
        ]
      }
    },
    {
      "if": {
        "required": [
          "reason"
        ],
        "properties": {
          "reason": {
            "type": "object",
            "required": [
              "basis"
            ],
            "properties": {
              "basis": {
                "enum": [
                  "close",
                  "slot",
                  "tracked"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "state": {
            "const": "failed"
          },
          "reason": {
            "type": "object",
            "properties": {
              "code": {
                "const": "payment_failed"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "finality": true
        },
        "required": [
          "finality"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "state": {
            "const": "settled"
          }
        },
        "required": [
          "state"
        ]
      }
    }
  ],
  "kyaUniqueProperty": {
    "array": "evidence",
    "property": "digest"
  },
  "$defs": {
    "reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "idempotency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "phase",
        "scope",
        "requestDigest"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "phase": {
          "enum": [
            "execute"
          ],
          "description": "The execution phase (profile section 8.2)."
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "requestDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "format",
        "digest",
        "canonicalization"
      ],
      "properties": {
        "type": {
          "$ref": "#/$defs/reference"
        },
        "format": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "ref": {
          "$ref": "#/$defs/reference",
          "type": "string",
          "pattern": "^(?:(?:https?|wss?|ftp|file)://[^/?#@\\\\\\s]+(?:/[^?#@\\\\\\s]*)?|(?!(?:https?|wss?|ftp|file|javascript|vbscript|data):)[a-z][a-z0-9+.-]*:[^?#@\\\\\\s]+)$",
          "description": "Where the evidence can be retrieved (profile section 9)."
        },
        "canonicalization": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "class": {
          "enum": [
            "authority",
            "approval",
            "commerce_terms",
            "funding_authority",
            "rail_authorization",
            "rail_receipt",
            "fulfillment",
            "refund_or_reversal",
            "communication"
          ]
        },
        "custodian": {
          "$ref": "#/$defs/reference"
        },
        "retentionPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "digest"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/reference"
            },
            "digest": {
              "$ref": "#/$defs/digest"
            }
          }
        },
        "finality": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]{0,63}$",
          "description": "The finality level of a settlement (profile sections 8.3 and 9)."
        }
      }
    },
    "extension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "critical",
        "data"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "schema": {
          "type": "string",
          "minLength": 2,
          "maxLength": 2048,
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\r\\n]+$"
        },
        "critical": {
          "type": "boolean"
        },
        "data": {
          "kyaCanonicalJson": {
            "maxBytes": 16384,
            "maxDepth": 16,
            "maxNodes": 1024
          }
        }
      }
    },
    "extensions": {
      "type": "object",
      "maxProperties": 64,
      "kyaCanonicalJsonCollection": {
        "property": "data",
        "maxBytes": 65536
      },
      "propertyNames": {
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^(?:[A-Za-z][A-Za-z0-9+.-]*:[^\\r\\n]+|[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+(?:[/.][A-Za-z0-9._~-]+)*)$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/extension"
      }
    },
    "amount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset",
        "coefficient",
        "scale"
      ],
      "properties": {
        "asset": {
          "$ref": "#/$defs/asset"
        },
        "coefficient": {
          "$ref": "#/$defs/canonicalInteger"
        },
        "scale": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      }
    },
    "asset": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "namespace",
            "id"
          ],
          "properties": {
            "namespace": {
              "const": "iso4217"
            },
            "id": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "namespace",
            "id"
          ],
          "properties": {
            "namespace": {
              "const": "caip19"
            },
            "id": {
              "type": "string",
              "maxLength": 258,
              "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,32}/[-a-z0-9]{3,8}:[-%.a-zA-Z0-9]{1,128}(?:/[-%.a-zA-Z0-9]{1,78})?$",
              "description": "A CAIP-19 asset identifier (profile section 7)."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "namespace",
            "id"
          ],
          "properties": {
            "namespace": {
              "const": "uri"
            },
            "id": {
              "type": "string",
              "minLength": 2,
              "maxLength": 2048,
              "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\r\\n]+$"
            }
          }
        }
      ]
    },
    "canonicalInteger": {
      "type": "string",
      "maxLength": 78,
      "pattern": "^(?:0|[1-9][0-9]*)$"
    }
  }
}
