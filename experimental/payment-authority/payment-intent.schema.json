{
  "$schema": "https://schema.kya-os.org/experimental/payment-authority/2026-09-22/meta",
  "$id": "https://schema.kya-os.org/experimental/payment-authority/2026-09-22/intent",
  "title": "KYA-OS Payment Intent (Experimental)",
  "description": "Experimental discussion draft: the Payment Intent of the KYA-OS Payment Authority Profile (profile section 8.1). Not stable or ratified.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profile",
    "intentId",
    "createdAt",
    "expiresAt",
    "audience",
    "action",
    "payee",
    "payer",
    "amount",
    "resources",
    "payment"
  ],
  "properties": {
    "schema": {
      "const": "https://schema.kya-os.org/experimental/payment-authority/2026-09-22/intent"
    },
    "profile": {
      "const": "org.kya-os/payments.v1"
    },
    "intentId": {
      "$ref": "#/$defs/reference"
    },
    "createdAt": {
      "$ref": "#/$defs/timestamp"
    },
    "expiresAt": {
      "$ref": "#/$defs/timestamp"
    },
    "audience": {
      "$ref": "#/$defs/did"
    },
    "action": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "payee": {
      "$ref": "#/$defs/party"
    },
    "payer": {
      "$ref": "#/$defs/did",
      "description": "The DID of the payer (profile section 8.1)."
    },
    "presenter": {
      "$ref": "#/$defs/did",
      "description": "The DID of the one agent that may present the intent (profile section 8.1)."
    },
    "amount": {
      "$ref": "#/$defs/amount"
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/resource"
      }
    },
    "commerce": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[Hh][Tt][Tt][Pp][Ss]?:"
              }
            },
            "required": [
              "id"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "specDigest": true
            },
            "required": [
              "specDigest"
            ]
          }
        }
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/reference"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "specDigest": {
          "$ref": "#/$defs/digest"
        },
        "sessionId": {
          "$ref": "#/$defs/reference"
        },
        "artifactDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "payment": {
      "$ref": "#/$defs/paymentSelection"
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    }
  },
  "if": {
    "type": "object",
    "required": ["payment"],
    "properties": {
      "payment": {
        "type": "object",
        "required": ["redeemableByOthers"],
        "properties": {
          "redeemableByOthers": {
            "const": true
          }
        }
      }
    }
  },
  "then": {
    "type": "object",
    "required": ["presenter", "payment"],
    "properties": {
      "presenter": {
        "$ref": "#/$defs/did"
      },
      "payment": {
        "type": "object",
        "required": ["fundingAccount"],
        "properties": {
          "fundingAccount": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    }
  },
  "kyaOrderedNumberRange": {
    "first": "createdAt",
    "last": "expiresAt",
    "exclusive": true
  },
  "kyaUniqueProperty": {
    "array": "resources",
    "property": "id"
  },
  "$defs": {
    "timestamp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "canonicalInteger": {
      "type": "string",
      "maxLength": 78,
      "pattern": "^(?:0|[1-9][0-9]*)$"
    },
    "asset": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "namespace",
            "id"
          ],
          "properties": {
            "namespace": {
              "const": "iso4217"
            },
            "id": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "namespace",
            "id"
          ],
          "properties": {
            "namespace": {
              "const": "caip19"
            },
            "id": {
              "type": "string",
              "maxLength": 258,
              "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,32}/[-a-z0-9]{3,8}:[-%.a-zA-Z0-9]{1,128}(?:/[-%.a-zA-Z0-9]{1,78})?$",
              "description": "A CAIP-19 asset identifier (profile section 7)."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "namespace",
            "id"
          ],
          "properties": {
            "namespace": {
              "const": "uri"
            },
            "id": {
              "type": "string",
              "minLength": 2,
              "maxLength": 2048,
              "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\r\\n]+$"
            }
          }
        }
      ]
    },
    "amount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset",
        "coefficient",
        "scale"
      ],
      "properties": {
        "asset": {
          "$ref": "#/$defs/asset"
        },
        "coefficient": {
          "$ref": "#/$defs/canonicalInteger"
        },
        "scale": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      }
    },
    "party": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "dependentRequired": {
        "accountDigest": [
          "accountDigestMethod"
        ],
        "accountDigestMethod": [
          "accountDigest"
        ]
      },
      "properties": {
        "id": {
          "$ref": "#/$defs/reference"
        },
        "accountDigest": {
          "$ref": "#/$defs/digest",
          "description": "An account commitment (profile section 7)."
        },
        "accountDigestMethod": {
          "enum": [
            "opaque-token-sha256",
            "hmac-sha256",
            "issuer-attestation-sha256"
          ],
          "description": "The construction of the account commitment (profile section 7)."
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "digest"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/reference"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "protocolRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[Hh][Tt][Tt][Pp][Ss]?:"
              }
            },
            "required": [
              "id"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "specDigest": true
            },
            "required": [
              "specDigest"
            ]
          }
        }
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/reference"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "specDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "paymentSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol"
      ],
      "dependentRequired": {
        "settlementAmount": [
          "quoteDigest"
        ]
      },
      "properties": {
        "protocol": {
          "$ref": "#/$defs/protocolRef"
        },
        "methodId": {
          "$ref": "#/$defs/reference"
        },
        "handlerId": {
          "$ref": "#/$defs/reference"
        },
        "scheme": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "network": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "transferMethod": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "paymentFlow": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "redeemableByOthers": {
          "const": true,
          "description": "The credential policy the intent signs (profile section 8.1)."
        },
        "fundingAccount": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "The account every credential for the intent debits (profile section 8.1)."
        },
        "settlementAmount": {
          "$ref": "#/$defs/amount"
        },
        "quoteDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "extension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "critical",
        "data"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "schema": {
          "type": "string",
          "minLength": 2,
          "maxLength": 2048,
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\r\\n]+$"
        },
        "critical": {
          "type": "boolean"
        },
        "data": {
          "kyaCanonicalJson": {
            "maxBytes": 16384,
            "maxDepth": 16,
            "maxNodes": 1024
          }
        }
      }
    },
    "extensions": {
      "type": "object",
      "maxProperties": 64,
      "kyaCanonicalJsonCollection": {
        "property": "data",
        "maxBytes": 65536
      },
      "propertyNames": {
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^(?:[A-Za-z][A-Za-z0-9+.-]*:[^\\r\\n]+|[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+(?:[/.][A-Za-z0-9._~-]+)*)$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/extension"
      }
    },
    "did": {
      "type": "string",
      "minLength": 5,
      "maxLength": 2048,
      "pattern": "^did:[^\\r\\n]+$"
    }
  }
}
