node_modules/
dist/
coverage/
.DS_Store
*.tgz

# Example projects regenerate their lockfiles at install time; pinning
# them in-tree rots the resolved URLs every time the parent package
# name or version moves.
examples/*/package-lock.json
examples/*/pnpm-lock.yaml

# This standalone workshop app uses published packages exclusively. Its lockfile
# makes clean npm 10 installs reproducible without circular peer re-resolution.
!examples/agentic-commerce/package-lock.json

# AI-assistant tooling artifacts. Kept out of the tree so contributors'
# local assistant configs don't leak into the public repository.
CLAUDE.md
CLAUDE_*.md
AGENTS.md
.claude/
.cursorrules
.cursor/
.aider*
.codex/

# Editor scratch
.vscode/
.idea/
